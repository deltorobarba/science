# Copy to .env and adjust. .env stays local (never commit it).

# Google Cloud
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global          # Gemini 3.x runs on 'global'
REGION=us-central1                    # Cloud Run, Agent Registry, Agent Runtime
MODEL=gemini-3.8-flash

# MCP server on Cloud Run (deployment/deploy_server.sh prints the URL)
MCP_SERVICE_NAME=bq-mcp-analyst
MCP_SERVER_URL=https://bq-mcp-analyst-PROJECT_NUMBER.us-central1.run.app
MCP_DISCOVERY=url                     # url: fixed URL | registry: look the server up in Agent Registry
MCP_REGISTRY_ID=bq-mcp-analyst

# Agent Runtime
STAGING_BUCKET=gs://your-staging-bucket
AGENT_ENGINE_NAME=                    # empty: deploy_agent.py creates a new engine; then paste its name here

# Developer Knowledge MCP (docs_expert): name of the Secret Manager secret that holds the API key
DK_SECRET_NAME=mcp-dk
