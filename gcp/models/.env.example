# Copy to .env and adjust. .env stays local (never commit it).

GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
MODEL_LOCATION=global          # Gemini 3.x and the MaaS partner models run on 'global'

# Model Garden deployments (may be a different project, with GPU quota in that region)
DEPLOY_PROJECT=your-project-id
DEPLOY_REGION=europe-west4
